# Which AI provider the backend uses.
# To use Gemini instead (Gemini sponsor track): comment the bedrock line, uncomment the gemini line, restart the server.
MODEL_PROVIDER=bedrock
# MODEL_PROVIDER=gemini

# Amazon Bedrock (default). Short-term Bedrock API key (12 h max on the team account). Regenerate before the demo.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# Google Gemini (also the automatic fallback if the Bedrock key expires)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hedged requests: after this many ms without an answer, fire a second identical call (first answer wins). 0 = off.
# 1500 = measured p75 of Nova 2 Lite model time, floored at 1500.
HEDGE_AFTER_MS=1500

PORT=8787

# Local speech-to-text container (server/voice)
WHISPER_URL=http://localhost:8790
